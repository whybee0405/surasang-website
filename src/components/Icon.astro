---
// Inlines a Phosphor icon (regular weight) at build time.
import { readFileSync } from 'node:fs'
import { createRequire } from 'node:module'

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 18, class: className = '', label } = Astro.props
const require = createRequire(import.meta.url)
const file = require.resolve(`@phosphor-icons/core/assets/regular/${name}.svg`)
const svg = readFileSync(file, 'utf8').replace(
  '<svg ',
  `<svg width="${size}" height="${size}" class="icon ${className}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} focusable="false" `,
)
---
<Fragment set:html={svg} />
