# Read by compose.yml (production) and compose.dev.yml. Copy to .env.

# A read key from the CMS (README: first install). Empty = the site builds from src/data/seed.js.
CLOUDIA_READ_KEY=
# The site's signing secret from the dashboard (Integrations). Empty = no rebuild on publish.
CLOUDIA_WEBHOOK_SECRET=
# CMS release to run in production (keep cloudia/cms-version in step).
CLOUDIA_CMS_VERSION=1.8.0
# 1 = load the CloudIA analytics tracker.
PUBLIC_CLOUDIA_TRACKER=1

# Only for testing the production stack on your machine:
# SITE_ADDRESS=:80
# HTTP_PORT=8080
# CLOUDIA_CMS_IMAGE=cloudia-cms:local
# CMS_NODE_ENV=development   (lets localhost post the contact form; never set this on the server)
