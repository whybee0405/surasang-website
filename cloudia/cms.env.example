# Copy to cloudia/cms.env (git-ignored) and fill in.
PUBLIC_URL=https://surasang.co.za
# Salt for the per-visitor form throttle. Any long random string.
FORM_SALT=
# Contact-form notifications, sent through Resend's SMTP relay.
# 1. In Resend, verify surasang.co.za (Domains) and create an API key with "Sending access".
# 2. Fill in SMTP_PASS and set `notify` on the messages form in cloudia/cloudia.config.ts.
# 3. Restart the cms container, then use "Send test email" on the System page.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxx
SMTP_FROM=Surasang website <website@surasang.co.za>
